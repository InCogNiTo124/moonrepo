<!DOCTYPE html>
<html lang="hr" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={~p"/images/egg.svg"} type="image/svg+xml" />
    <title>404 · Smetkova jaja</title>
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
  </head>
  <body class="bg-base-100 text-base-content antialiased font-sans min-h-screen flex items-center justify-center p-6">
    <div class="card bg-base-300 shadow-xl max-w-md w-full text-center">
      <div class="card-body items-center space-y-4">
        <div class="text-6xl font-extrabold text-primary">404</div>
        <h1 class="text-2xl font-bold">Stranica nije pronađena</h1>
        <p class="text-base-content/70">
          Ova stranica ili ponuda ne postoji (ili se jaje putem razbilo).
        </p>
        <div class="card-actions pt-2 w-full">
          <a href={~p"/"} class="btn btn-primary w-full">
            Natrag na početnu
          </a>
        </div>
      </div>
    </div>
  </body>
</html>
